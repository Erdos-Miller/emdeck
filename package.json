{
  "name": "emdeck-ide",
  "private": true,
  "version": "0.1.21",
  "license": "Apache-2.0",
  "author": "Erdos Miller",
  "description": "A lightweight open-source workspace for agent-driven development",
  "repository": {
    "type": "git",
    "url": "https://github.com/Erdos-Miller/emdeck.git"
  },
  "homepage": "https://github.com/Erdos-Miller/emdeck",
  "bugs": "https://github.com/Erdos-Miller/emdeck/issues",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test": "vitest run",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:ui": "bun run test:e2e",
    "type-check": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:check": "node scripts/check-architecture.mjs boundaries",
    "code-size:check": "node scripts/check-architecture.mjs size",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "bun run build && playwright test",
    "check": "bun run lint:check && bun run type-check && bun run format:check && bun run architecture:check && bun run code-size:check",
    "verify": "bun run check && bun run test:unit && bun run test:integration && bun run test:native && bun run test:e2e",
    "release:tools": "node scripts/release/tools.mjs",
    "release:check": "node scripts/release/metadata.mjs",
    "security:check": "node scripts/release/audit.mjs",
    "security:rust": "node scripts/release/rust-audit.mjs",
    "licenses:generate": "node scripts/release/javascript-licenses.mjs && node scripts/release/rust-licenses.mjs",
    "workflows:check": "node scripts/release/workflows.mjs",
    "test:soak": "cargo test --manifest-path src-tauri/Cargo.toml --locked terminal::stress::six_terminals_stream_resize_and_shutdown -- --ignored --nocapture"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.12.0",
    "prettier": "^3.9.6",
    "spdx-expression-parse": "4.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.14.0",
    "vite": "^7.1.4",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": "^22.12.0"
  }
}
