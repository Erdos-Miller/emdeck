{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emdeck",
  "version": "0.1.21",
  "identifier": "dev.relay.ide",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Emdeck",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#121418"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https: http:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "publisher": "Erdos Miller",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../NOTICE": "licenses/NOTICE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../docs/licenses/JAVASCRIPT.md": "licenses/JAVASCRIPT.md",
      "../docs/licenses/RUST.md": "licenses/RUST.md"
    },
    "active": true,
    "targets": "all",
    "shortDescription": "Your code. Your agents. One workspace.",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
