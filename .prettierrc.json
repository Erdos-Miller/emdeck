{
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "jsxSingleQuote": true,
  "overrides": [
    { "files": "*.md", "options": { "printWidth": 80, "proseWrap": "always" } },
    { "files": "*.json", "options": { "printWidth": 200 } },
    { "files": "*.{yml,yaml}", "options": { "printWidth": 120, "singleQuote": false } },
    { "files": "*.css", "options": { "singleQuote": false } }
  ]
}
